<Window x:Class="KHZ.AssetRegister.ExcelImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KHZ Asset Register - Excel Import Preview"
        Width="1500"
        Height="780"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="EXCEL IMPORT PREVIEW"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock x:Name="SourceText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="Select All"
                            Click="SelectAll_Click"/>
                    <Button Content="Clear Selection"
                            Click="ClearSelection_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="PreviewGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeColumns="True"
                  CanUserSortColumns="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  GridLinesVisibility="All"
                  HeadersVisibility="All"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  FrozenColumnCount="2"
                  RowHeaderWidth="36"
                  RowHeight="25"
                  Background="{DynamicResource SurfaceBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Import"
                                        Width="65"
                                        Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <DataGridTextColumn Header="AssetTag" Width="130" Binding="{Binding AssetTag}"/>
                <DataGridTextColumn Header="SerialNumber" Width="130" Binding="{Binding SerialNumber}"/>
                <DataGridTextColumn Header="Barcode" Width="120" Binding="{Binding Barcode}"/>
                <DataGridTextColumn Header="Category" Width="110" Binding="{Binding Category}"/>
                <DataGridTextColumn Header="Description" Width="220" Binding="{Binding Description}"/>
                <DataGridTextColumn Header="Manufacturer" Width="130" Binding="{Binding Manufacturer}"/>
                <DataGridTextColumn Header="Model" Width="120" Binding="{Binding Model}"/>
                <DataGridTextColumn Header="Location" Width="130" Binding="{Binding Location}"/>
                <DataGridTextColumn Header="Department" Width="130" Binding="{Binding Department}"/>
                <DataGridTextColumn Header="Custodian" Width="140" Binding="{Binding Custodian}"/>
                <DataGridTextColumn Header="Status" Width="110" Binding="{Binding Status}"/>
                <DataGridTextColumn Header="PurchaseDate" Width="110" Binding="{Binding PurchaseDate}"/>
                <DataGridTextColumn Header="PurchaseCost" Width="110" Binding="{Binding PurchaseCost}"/>
                <DataGridTextColumn Header="WarrantyExpiry" Width="120" Binding="{Binding WarrantyExpiry}"/>
                <DataGridTextColumn Header="Condition" Width="100" Binding="{Binding Condition}"/>
                <DataGridTextColumn Header="Notes" Width="260" Binding="{Binding Notes}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CountText"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <Button Content="Cancel"
                            Click="Cancel_Click"/>
                    <Button Content="Import Selected"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Click="ImportSelected_Click"/>
                    <Button Content="Import All"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource AccentForegroundBrush}"
                            Click="ImportAll_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
