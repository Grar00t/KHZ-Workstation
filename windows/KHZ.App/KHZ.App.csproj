<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>KHZ-Workstation</AssemblyName>
    <Product>KHZ Workstation</Product>
    <Company>KHZ</Company>
    <Authors>Sulaiman Alshammari</Authors>
    <Description>Local-first institutional workstation</Description>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>Assets\KHZ.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\KHZ.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
</Project>