<UserControl x:Class="KHZ.App.Views.IntegrationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="760"
                    Margin="34"
                    HorizontalAlignment="Left">

            <TextBlock Text="Integrations"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#202020"/>

            <TextBlock Text="Optional institutional system configuration"
                       Margin="0,4,0,20"
                       FontSize="14"
                       Foreground="#707070"/>

            <Border Background="#FFF8E8"
                    BorderBrush="#E3C878"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14"
                    Margin="0,0,0,18">
                <TextBlock TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="#625628"
                           Text="Configuration only. Saving does not open a network connection. Credentials are not stored here."/>
            </Border>

            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="22"
                    Margin="0,0,0,16">

                <StackPanel>
                    <TextBlock Text="Oracle E-Business Suite"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Optional institutional business-system endpoint"
                               Margin="0,3,0,16"
                               FontSize="11"
                               Foreground="#777777"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Status"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="OracleStatusText"
                                   Grid.Column="1"
                                   Text="Not configured"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1"
                                   Text="Base URL"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="OracleBaseUrlBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Height="32"
                                 Padding="8,4"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Row="2"
                                Grid.Column="1"
                                Content="Save configuration"
                                Width="140"
                                Height="30"
                                HorizontalAlignment="Left"
                                Click="SaveOracle_Click"/>
                    </Grid>

                    <TextBlock x:Name="OracleFeedbackText"
                               Margin="160,10,0,0"
                               FontSize="11"
                               Foreground="#555555"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="22">

                <StackPanel>
                    <TextBlock Text="PostgreSQL"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Optional shared or institutional database target"
                               Margin="0,3,0,16"
                               FontSize="11"
                               Foreground="#777777"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="38"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Status"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="PostgresStatusText"
                                   Grid.Column="1"
                                   Text="Not configured"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>

                        <TextBlock Grid.Row="1"
                                   Text="Host"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="PostgresHostBox"
                                 Grid.Row="1"
                                 Grid.Column="1"
                                 Height="32"
                                 Padding="8,4"/>

                        <TextBlock Grid.Row="2"
                                   Text="Port"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="PostgresPortBox"
                                 Grid.Row="2"
                                 Grid.Column="1"
                                 Width="100"
                                 Height="32"
                                 HorizontalAlignment="Left"
                                 Padding="8,4"
                                 Text="5432"/>

                        <TextBlock Grid.Row="3"
                                   Text="Database"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="PostgresDatabaseBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Height="32"
                                 Padding="8,4"/>

                        <Button Grid.Row="4"
                                Grid.Column="1"
                                Content="Save configuration"
                                Width="140"
                                Height="30"
                                HorizontalAlignment="Left"
                                Click="SavePostgres_Click"/>
                    </Grid>

                    <TextBlock x:Name="PostgresFeedbackText"
                               Margin="160,10,0,0"
                               FontSize="11"
                               Foreground="#555555"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
