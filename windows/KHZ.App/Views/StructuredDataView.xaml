<UserControl x:Class="KHZ.App.Views.StructuredDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5"
             AutomationProperties.AutomationId="StructuredDataSurface">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Structured Data"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#202020"/>

            <TextBlock x:Name="WorkspaceStatusText"
                       AutomationProperties.AutomationId="StructuredDataWorkspaceStatus"
                       Text="Folder mode · activate a workspace to use Structured Data"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="#707070"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,14"
                Padding="14"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">

            <WrapPanel>
                <Button x:Name="ImportCsvButton"
                        AutomationProperties.AutomationId="StructuredDataImportCsvButton"
                        Content="Import CSV"
                        Height="34"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="ImportCsv_Click"/>

                <Button x:Name="ImportXlsxButton"
                        AutomationProperties.AutomationId="StructuredDataImportXlsxButton"
                        Content="Import XLSX"
                        Height="34"
                        Padding="14,0"
                        Margin="0,0,18,0"
                        IsEnabled="False"
                        Click="ImportXlsx_Click"/>

                <Button x:Name="ExportCsvButton"
                        AutomationProperties.AutomationId="StructuredDataExportCsvButton"
                        Content="Export CSV"
                        Height="34"
                        Padding="14,0"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="ExportCsv_Click"/>

                <Button x:Name="ExportXlsxButton"
                        AutomationProperties.AutomationId="StructuredDataExportXlsxButton"
                        Content="Export XLSX"
                        Height="34"
                        Padding="14,0"
                        Margin="0,0,18,0"
                        IsEnabled="False"
                        Click="ExportXlsx_Click"/>

                <Button x:Name="RefreshButton"
                        AutomationProperties.AutomationId="StructuredDataRefreshButton"
                        Content="Refresh"
                        Height="34"
                        Padding="14,0"
                        IsEnabled="False"
                        Click="Refresh_Click"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#E5E5E5"
                            BorderThickness="0,0,0,1">

                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="TABLES"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#707070"/>

                            <TextBlock x:Name="TableCountText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="#888888"
                                       Text="0"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="TablesGrid"
                              Grid.Row="1"
                              AutomationProperties.AutomationId="StructuredDataTablesGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="White"
                              SelectionChanged="TablesGrid_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Table"
                                                Width="*"
                                                Binding="{Binding Name}"/>

                            <DataGridTextColumn Header="Rows"
                                                Width="70"
                                                Binding="{Binding RowCount}"/>

                            <DataGridTextColumn Header="Columns"
                                                Width="70"
                                                Binding="{Binding ColumnCount}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border BorderBrush="#E5E5E5"
                            BorderThickness="0,0,0,1">

                        <Grid Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="PreviewTitleText"
                                       Text="PREVIEW"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#707070"/>

                            <TextBlock x:Name="PreviewCountText"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="#888888"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="PreviewGrid"
                              Grid.Row="1"
                              AutomationProperties.AutomationId="StructuredDataPreviewGrid"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="All"
                              BorderThickness="0"
                              Background="White"/>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   AutomationProperties.AutomationId="StructuredDataErrorText"
                   Margin="0,10,0,0"
                   Foreground="#B42318"
                   FontSize="11"
                   TextWrapping="Wrap"/>
    </Grid>
</UserControl>
