<UserControl x:Class="KHZ.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30"
                    Width="960"
                    HorizontalAlignment="Left">

            <TextBlock Text="Terminal"
                       FontSize="28"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Explicit user-initiated PowerShell execution"
                       Margin="0,4,0,0"
                       Foreground="#666666"/>

            <Border Background="#FFF4E5"
                    BorderBrush="#E6B566"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="14"
                    Margin="0,18,0,0">

                <TextBlock TextWrapping="Wrap"
                           Foreground="#5F4500"
                           Text="PowerShell commands run under the signed-in Windows account. This is not a sandbox. Commands may access files, start processes, or use network access permitted by Windows. Session enablement is not persisted. Command text is not written to Activity."/>
            </Border>

            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="16"
                    Margin="0,18,0,0">

                <StackPanel>
                    <TextBlock Text="SESSION"
                               FontSize="11"
                               Foreground="#666666"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Working directory"
                                       Foreground="#666666"
                                       FontSize="11"/>

                            <TextBox x:Name="TerminalWorkingDirectoryText"
                                     IsReadOnly="True"
                                     Margin="0,5,12,0"
                                     Padding="8"/>
                        </StackPanel>

                        <Button x:Name="TerminalSessionButton"
                                AutomationProperties.AutomationId="TerminalSessionButton"
                                AutomationProperties.Name="Enable or disable terminal for this session"
                                Grid.Column="1"
                                Width="190"
                                Height="34"
                                VerticalAlignment="Bottom"
                                Content="Enable for this session"
                                Click="TerminalSession_Click"/>
                    </Grid>

                    <TextBlock x:Name="TerminalSessionStatusText"
                               Margin="0,10,0,0"
                               FontWeight="SemiBold"
                               Text="Disabled"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="16"
                    Margin="0,16,0,0">

                <StackPanel>
                    <TextBlock Text="COMMAND"
                               FontSize="11"
                               Foreground="#666666"/>

                    <TextBox x:Name="TerminalCommandText"
                             AutomationProperties.AutomationId="TerminalCommandText"
                             AutomationProperties.Name="Terminal command"
                             Height="110"
                             Margin="0,10,0,0"
                             Padding="10"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             SpellCheck.IsEnabled="False"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <Button x:Name="TerminalRunButton"
                                AutomationProperties.AutomationId="TerminalRunButton"
                                AutomationProperties.Name="Run terminal command"
                                Width="110"
                                Height="34"
                                Content="Run"
                                IsEnabled="False"
                                Click="Run_Click"/>

                        <Button x:Name="TerminalCancelButton"
                                AutomationProperties.AutomationId="TerminalCancelButton"
                                AutomationProperties.Name="Cancel terminal command"
                                Width="110"
                                Height="34"
                                Margin="10,0,0,0"
                                Content="Cancel"
                                IsEnabled="False"
                                Click="Cancel_Click"/>
                    </StackPanel>

                    <TextBlock x:Name="TerminalErrorText"
                               Margin="0,10,0,0"
                               Foreground="#B91C1C"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Border Background="#151515"
                    BorderBrush="#333333"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="12"
                    Margin="0,16,0,24">

                <StackPanel>
                    <TextBlock Text="OUTPUT"
                               Foreground="#AAAAAA"
                               FontSize="11"/>

                    <TextBox x:Name="TerminalOutputText"
                             AutomationProperties.AutomationId="TerminalOutputText"
                             AutomationProperties.Name="Terminal output"
                             Height="320"
                             Margin="0,8,0,0"
                             Padding="8"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             Background="#151515"
                             Foreground="#EEEEEE"
                             BorderThickness="0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
