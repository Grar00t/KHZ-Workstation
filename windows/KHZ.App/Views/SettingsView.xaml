<UserControl x:Class="KHZ.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30"
                    Width="960"
                    HorizontalAlignment="Left">

            <TextBlock Text="Settings"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#202020"/>

            <TextBlock Text="Local workstation preferences"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="#707070"/>

            <Border Margin="0,20,0,0"
                    Padding="20"
                    Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6">

                <StackPanel>
                    <TextBlock Text="Workspace"
                               FontSize="18"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="Default folder used when KHZ Workstation starts"
                               Margin="0,3,0,18"
                               FontSize="11"
                               Foreground="#777777"/>

                    <TextBlock Text="Default workspace folder"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="WorkspaceFolderText"
                                 AutomationProperties.AutomationId="SettingsWorkspaceFolderText"
                                 AutomationProperties.Name="Default workspace folder"
                                 Height="34"
                                 Padding="9,5"
                                 IsReadOnly="True"
                                 VerticalContentAlignment="Center"/>

                        <Button x:Name="ChooseWorkspaceButton"
                                AutomationProperties.AutomationId="SettingsChooseWorkspaceButton"
                                AutomationProperties.Name="Choose workspace folder"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Height="34"
                                Content="Choose folder"
                                Click="ChooseWorkspace_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,12,0,0">

                        <Button x:Name="SaveWorkspaceButton"
                                AutomationProperties.AutomationId="SettingsSaveWorkspaceButton"
                                AutomationProperties.Name="Save default workspace folder"
                                Width="125"
                                Height="32"
                                Content="Save default"
                                Click="SaveWorkspace_Click"/>

                        <Button x:Name="ResetWorkspaceButton"
                                AutomationProperties.AutomationId="SettingsResetWorkspaceButton"
                                AutomationProperties.Name="Reset workspace folder to Documents"
                                Width="155"
                                Height="32"
                                Margin="8,0,0,0"
                                Content="Reset to Documents"
                                Click="ResetWorkspace_Click"/>
                    </StackPanel>

                    <Separator Margin="0,20,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="32"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Saved preference"
                                   VerticalAlignment="Center"
                                   Foreground="#666666"/>

                        <TextBlock x:Name="SavedPreferenceText"
                                   AutomationProperties.AutomationId="SettingsSavedPreferenceText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="Not configured"/>

                        <TextBlock Grid.Row="1"
                                   Text="Effective next launch"
                                   VerticalAlignment="Center"
                                   Foreground="#666666"/>

                        <TextBlock x:Name="EffectiveWorkspaceText"
                                   AutomationProperties.AutomationId="SettingsEffectiveWorkspaceText"
                                   Grid.Row="1"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>

                    <TextBlock x:Name="SettingsFeedbackText"
                               AutomationProperties.AutomationId="SettingsFeedbackText"
                               Margin="0,14,0,0"
                               FontSize="11"
                               Foreground="#555555"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
