<Window x:Class="KHZ.App.Views.NiyahChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:KHZ.App.Views"
        Title="Niyah - KHZ Workstation"
        Height="820"
        Width="1280"
        MinHeight="560"
        MinWidth="920"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        Background="#FFF7F7F8"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <SolidColorBrush x:Key="SidebarBrush" Color="#FF171717" />
        <SolidColorBrush x:Key="SidebarTextBrush" Color="#FFEDEDED" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF10A37F" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF6E6E80" />

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#FF2A2A2A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Opacity="{TemplateBinding Opacity}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="268" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="نيّة"
                               Foreground="{StaticResource SidebarTextBrush}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="12,8,12,2" />
                    <TextBlock Text="وكيل محلي تنفيذي"
                               Foreground="#FF9A9AA5"
                               FontSize="12"
                               Margin="12,0,12,14" />

                    <Button Style="{StaticResource SidebarButton}"
                            Click="OnNewChat"
                            Content="+  محادثة جديدة" />
                    <Button Style="{StaticResource SidebarButton}"
                            Click="OnPickRoot"
                            Content="اختيار مجلد العمل" />
                    <Button Style="{StaticResource SidebarButton}"
                            Click="OnReconnectMcp"
                            Content="إعادة ربط خوادم MCP" />
                    <Button Style="{StaticResource SidebarButton}"
                            Click="OnOpenMcpConfig"
                            Content="فتح ملف إعداد MCP" />

                    <Separator Margin="8,14" Background="#FF303030" />

                    <TextBlock Text="مجلد العمل"
                               Foreground="#FF9A9AA5"
                               FontSize="11"
                               Margin="12,0,12,4" />
                    <TextBlock Text="{Binding RootPath}"
                               Foreground="{StaticResource SidebarTextBrush}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="12,0,12,12" />

                    <TextBlock Text="خوادم MCP"
                               Foreground="#FF9A9AA5"
                               FontSize="11"
                               Margin="12,0,12,4" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,10,12,4">
                    <TextBlock Text="{Binding ToolSummary}"
                               Foreground="#FF9A9AA5"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FF232323"
                                        CornerRadius="6"
                                        Padding="10,8"
                                        Margin="6,3">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource SidebarTextBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Foreground="#FF9A9AA5"
                                                   FontSize="11"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Conversation -->
        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top"
                    Background="White"
                    BorderBrush="#FFE5E5E5"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               Text="{Binding StatusText}"
                               Foreground="{StaticResource MutedBrush}"
                               VerticalAlignment="Center"
                               FontSize="12" />
                    <TextBlock Text="محادثة تنفيذية"
                               HorizontalAlignment="Left"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>

            <Border DockPanel.Dock="Bottom"
                    Background="White"
                    BorderBrush="#FFE5E5E5"
                    BorderThickness="0,1,0,0"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="#FFD9D9E3"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,8"
                            Background="#FFFCFCFC">
                        <TextBox x:Name="Composer"
                                 Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="14"
                                 MinHeight="26"
                                 MaxHeight="160"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="OnComposerKeyDown" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Margin="10,0,0,0"
                                VerticalAlignment="Bottom">
                        <Button Style="{StaticResource PrimaryButton}"
                                Content="إرسال"
                                Click="OnSend"
                                IsEnabled="{Binding CanSend}" />
                        <Button Style="{StaticResource SidebarButton}"
                                Foreground="#FFB00020"
                                Content="إيقاف"
                                Margin="8,0,0,0"
                                Click="OnStop"
                                IsEnabled="{Binding IsBusy}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="Transcript"
                          VerticalScrollBarVisibility="Auto"
                          Padding="28,18">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,14"
                                    Padding="14,11"
                                    CornerRadius="10"
                                    Background="{Binding Background}"
                                    BorderBrush="#FFE5E5E5"
                                    BorderThickness="1"
                                    HorizontalAlignment="Stretch">
                                <StackPanel>
                                    <TextBlock Text="{Binding Author}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,0,0,6" />
                                    <TextBox Text="{Binding Text, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             TextWrapping="Wrap"
                                             FontFamily="{Binding FontFamily}"
                                             FontSize="13.5"
                                             IsTabStop="False" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
