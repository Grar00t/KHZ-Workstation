<UserControl x:Class="KHZ.App.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30"
                    MaxWidth="900"
                    HorizontalAlignment="Left">

            <Grid Width="900">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Security Center"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#202020"/>

                    <TextBlock Text="Runtime boundaries and local trust state"
                               FontSize="11"
                               Foreground="#777777"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="SecurityErrorText"
                               Text=""
                               FontSize="10"
                               Foreground="#B42318"
                               Margin="0,5,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Refresh checks"
                        Padding="18,7"
                        VerticalAlignment="Center"
                        Click="RefreshSecurity_Click"/>
            </Grid>

            <TextBlock Text="LOCAL STATE"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#777777"
                       Margin="0,28,0,9"/>

            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18"
                    Width="900">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Database provider"
                               Foreground="#777777"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               Text="SQLite · Local"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="1"
                               Text="Integrity"
                               Foreground="#777777"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="SecurityIntegrityText"
                               Grid.Row="1"
                               Grid.Column="1"
                               Text="Not checked"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="2"
                               Text="Database path"
                               Foreground="#777777"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="SecurityDatabasePathText"
                               Grid.Row="2"
                               Grid.Column="1"
                               Text="--"
                               TextWrapping="Wrap"
                               FontFamily="Consolas"
                               FontSize="10"
                               Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <TextBlock Text="CAPABILITY POLICY"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#777777"
                       Margin="0,24,0,9"/>

            <Border Background="White"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="18"
                    Width="900">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
</Grid.RowDefinitions>

                    <TextBlock Text="Local Office navigation"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityOfficeNavigationText"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="1"
                               Text="Local file launch"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityFileLaunchText"
                               Grid.Row="1"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="2"
                               Text="External web navigation"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityExternalWebText"
                               Grid.Row="2"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="3"
                               Text="Institutional network"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityInstitutionalNetworkText"
                               Grid.Row="3"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="4"
                               Text="Internet egress"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityInternetEgressText"
                               Grid.Row="4"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="5"
                               Text="Arbitrary process execution"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityProcessText"
                               Grid.Row="5"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="6"
                               Text="Integration write"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityIntegrationWriteText"
                               Grid.Row="6"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="7"
                               Text="AI inference capability"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityAiText"
                               Grid.Row="7"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="8"
                               Text="Local repository inspection"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityRepositoryInspectionText"
                               Grid.Row="8"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <TextBlock Grid.Row="9"
                               Text="User terminal execution"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="SecurityUserTerminalText"
                               Grid.Row="9"
                               Grid.Column="1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"/>
                </Grid>
            </Border>

            <Border Background="#EEEEEE"
                    CornerRadius="5"
                    Padding="14"
                    Width="900"
                    Margin="0,18,0,24">

                <TextBlock TextWrapping="Wrap"
                           Foreground="#666666"
                           FontSize="11"
                           Text="Capability status describes permissions enforced by KHZ code paths. It does not claim that Windows or every external process is globally isolated."/>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
