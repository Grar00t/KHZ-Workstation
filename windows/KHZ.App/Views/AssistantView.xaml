<UserControl x:Class="KHZ.App.Views.AssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="#B78237"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModelStatusText"
                                   Text="Local model session not connected"
                                   FontWeight="SemiBold"
                                   Foreground="#303030"/>
                    </StackPanel>
                    <TextBlock x:Name="WorkspaceStatusText"
                               Text="Workspace tools are read/search/propose only"
                               Foreground="#777777"
                               FontSize="10"
                               Margin="16,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Refresh session"
                        Padding="14,6"
                        Click="RefreshSession_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <Border Background="White"
                    BorderBrush="#DADADA"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid>
                    <wv2:WebView2 x:Name="AssistantWeb"/>
                    <Border x:Name="DisconnectedPanel"
                            Background="#FAFAFA"
                            Visibility="Visible">
                        <StackPanel Width="520"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="KHZ Local Assistant"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DisconnectedText"
                                       Text="Start a workspace-scoped local model session from the terminal."
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="#666666"
                                       Margin="0,12,0,18"/>
                            <Border Background="#EFEFEF"
                                    CornerRadius="6"
                                    Padding="14,10">
                                <TextBlock Text="khz serve qwen --workspace &lt;path&gt;"
                                           FontFamily="Cascadia Mono, Consolas"
                                           HorizontalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Install first with: khz pull qwen · llama · phi"
                                       Foreground="#777777"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Background="White"
                    BorderBrush="#DADADA"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Pending workspace changes"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="The model cannot apply these changes."
                                   Foreground="#777777"
                                   FontSize="10"
                                   Margin="0,3,0,10"/>
                    </StackPanel>

                    <ListBox x:Name="ProposalList"
                             Grid.Row="1"
                             DisplayMemberPath="Display"
                             SelectionChanged="ProposalList_SelectionChanged"/>

                    <TextBlock x:Name="ProposalTargetText"
                               Grid.Row="2"
                               Text="Select a proposal to preview"
                               TextTrimming="CharacterEllipsis"
                               FontWeight="SemiBold"
                               Margin="0,12,0,6"/>

                    <TextBox x:Name="ProposalPreviewText"
                             Grid.Row="3"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="RejectProposalButton"
                                Content="Reject"
                                Height="34"
                                Margin="0,0,5,0"
                                IsEnabled="False"
                                Click="RejectProposal_Click"/>
                        <Button x:Name="ApplyProposalButton"
                                Grid.Column="1"
                                Content="Review &amp; Apply"
                                Height="34"
                                Margin="5,0,0,0"
                                Background="#202020"
                                Foreground="White"
                                IsEnabled="False"
                                Click="ApplyProposal_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="2"
                   Foreground="#B42318"
                   TextWrapping="Wrap"
                   Margin="18,0,18,10"/>
    </Grid>
</UserControl>
