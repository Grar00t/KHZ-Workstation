<UserControl x:Class="KHZ.App.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Search"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#202020"/>

            <TextBlock Text="File names in the current folder and recent local activity"
                       Margin="0,4,0,4"
                       FontSize="13"
                       Foreground="#707070"/>

            <TextBlock x:Name="RootPathText"
                       FontSize="10"
                       Foreground="#888888"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,18,0,0"
              MaxWidth="900"
              HorizontalAlignment="Left">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="620"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryBox"
                     Height="36"
                     Padding="10,6"
                     FontSize="13"
                     VerticalContentAlignment="Center"
                     KeyDown="QueryBox_KeyDown"/>

            <Button Grid.Column="1"
                    Content="Search"
                    Width="100"
                    Height="36"
                    Margin="8,0,0,0"
                    Click="Search_Click"/>
        </Grid>

        <TextBlock x:Name="SearchErrorText"
                   Grid.Row="2"
                   Margin="0,8,0,0"
                   Foreground="#B42318"
                   FontSize="11"
                   TextWrapping="Wrap"/>

        <ScrollViewer Grid.Row="3"
                      Margin="0,18,0,0"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel MaxWidth="1050"
                        HorizontalAlignment="Left">

                <TextBlock x:Name="FilesCountText"
                           Text="FILES"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#777777"
                           Margin="0,0,0,8"/>

                <Border Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="6"
                        Margin="0,0,0,22">

                    <ListView x:Name="FilesResults"
                              MinHeight="120"
                              MaxHeight="280"
                              BorderThickness="0"
                              MouseDoubleClick="FilesResults_MouseDoubleClick">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name"
                                                Width="280"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type"
                                                Width="90"
                                                DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="Modified"
                                                Width="150"
                                                DisplayMemberBinding="{Binding Modified}"/>
                                <GridViewColumn Header="Path"
                                                Width="450"
                                                DisplayMemberBinding="{Binding FullPath}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

                <TextBlock x:Name="ActivityCountText"
                           Text="ACTIVITY"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="#777777"
                           Margin="0,0,0,8"/>

                <Border Background="White"
                        BorderBrush="#DDDDDD"
                        BorderThickness="1"
                        CornerRadius="6">

                    <ListView x:Name="ActivityResults"
                              MinHeight="160"
                              MaxHeight="360"
                              BorderThickness="0">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time"
                                                Width="150"
                                                DisplayMemberBinding="{Binding DisplayTime}"/>
                                <GridViewColumn Header="Category"
                                                Width="120"
                                                DisplayMemberBinding="{Binding Category}"/>
                                <GridViewColumn Header="Action"
                                                Width="190"
                                                DisplayMemberBinding="{Binding Action}"/>
                                <GridViewColumn Header="Result"
                                                Width="100"
                                                DisplayMemberBinding="{Binding Result}"/>
                                <GridViewColumn Header="Target"
                                                Width="450"
                                                DisplayMemberBinding="{Binding Target}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
