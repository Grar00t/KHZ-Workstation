<UserControl x:Class="KHZ.App.Views.RepositoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Repositories"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#202020"/>

            <TextBlock Text="Read-only local Git repository inspection"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="#707070"/>

            <TextBlock Text="No commit, push, pull, fetch, checkout, reset, or repository modification."
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="#777777"/>
        </StackPanel>

        <Border Grid.Row="1"
                Width="1000"
                Margin="0,20,0,0"
                Padding="16"
                HorizontalAlignment="Left"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="RepositoryPathBox"
                         Height="34"
                         Padding="9,5"
                         Margin="0,0,10,0"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                        Height="34"
                        Margin="0,0,10,0"
                        Content="Choose folder"
                        Click="ChooseFolder_Click"/>

                <Button x:Name="InspectButton"
                        Grid.Column="2"
                        Height="34"
                        Content="Inspect"
                        Click="Inspect_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Width="1000"
                Margin="0,14,0,0"
                Padding="16"
                HorizontalAlignment="Left"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="260"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Repository root"
                           VerticalAlignment="Center"
                           Foreground="#666666"/>

                <TextBlock x:Name="RepositoryRootText"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>

                <TextBlock Grid.Row="1"
                           Text="Branch"
                           VerticalAlignment="Center"
                           Foreground="#666666"/>

                <TextBlock x:Name="RepositoryBranchText"
                           Grid.Row="1"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="Status"
                           VerticalAlignment="Center"
                           Foreground="#666666"/>

                <TextBlock x:Name="RepositoryStatusText"
                           Grid.Row="1"
                           Grid.Column="3"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>

                <TextBlock Grid.Row="2"
                           Text="HEAD"
                           VerticalAlignment="Center"
                           Foreground="#666666"/>

                <TextBlock x:Name="RepositoryHeadText"
                           Grid.Row="2"
                           Grid.Column="1"
                           Grid.ColumnSpan="3"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="11"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3"
              Width="1000"
              Margin="0,16,0,0"
              HorizontalAlignment="Left">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="220"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="ChangesHeaderText"
                       Text="CHANGED FILES"
                       Margin="0,0,0,7"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#777777"/>

            <DataGrid x:Name="ChangesGrid"
                      Grid.Row="1"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      BorderBrush="#DDDDDD"
                      BorderThickness="1">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status"
                                        Width="100"
                                        Binding="{Binding Status}"/>

                    <DataGridTextColumn Header="Path"
                                        Width="*"
                                        Binding="{Binding Path}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="CommitsHeaderText"
                       Grid.Row="2"
                       Text="RECENT COMMITS"
                       Margin="0,16,0,7"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#777777"/>

            <DataGrid x:Name="CommitsGrid"
                      Grid.Row="3"
                      MinHeight="220"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      BorderBrush="#DDDDDD"
                      BorderThickness="1">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="SHA"
                                        Width="90"
                                        Binding="{Binding ShortSha}"/>

                    <DataGridTextColumn Header="Date"
                                        Width="220"
                                        Binding="{Binding Occurred}"/>

                    <DataGridTextColumn Header="Subject"
                                        Width="*"
                                        Binding="{Binding Subject}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="RepositoryErrorText"
                       Grid.Row="4"
                       Margin="0,8,0,0"
                       Foreground="#B42318"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
