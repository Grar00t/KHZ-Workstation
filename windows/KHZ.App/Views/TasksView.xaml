<UserControl x:Class="KHZ.App.Views.TasksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Tasks"
                       FontSize="30"
                       FontWeight="SemiBold"
                       Foreground="#202020"/>

            <TextBlock Text="Local tasks stored on this workstation"
                       Margin="0,4,0,0"
                       FontSize="13"
                       Foreground="#707070"/>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,20,0,0"
                Padding="18"
                Width="960"
                MaxWidth="960"
                HorizontalAlignment="Left"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TaskTitleBox"
                         Height="34"
                         Margin="0,0,10,0"
                         Padding="9,5"
                         VerticalContentAlignment="Center"
                         ToolTip="Task title"/>

                <DatePicker x:Name="TaskDueDatePicker"
                            Grid.Column="1"
                            Height="34"
                            Margin="0,0,10,0"
                            VerticalContentAlignment="Center"
                            ToolTip="Optional due date"/>

                <Button Grid.Column="2"
                        Content="Add task"
                        Height="34"
                        Click="AddTask_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2"
              Margin="0,14,0,8"
              MaxWidth="960"
              HorizontalAlignment="Left">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TaskCountText"
                       Text="TASKS"
                       VerticalAlignment="Center"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#777777"/>

            <Button Grid.Column="1"
                    Content="Complete selected"
                    Height="30"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    Click="CompleteSelected_Click"/>

            <Button Grid.Column="2"
                    Content="Reopen selected"
                    Height="30"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    Click="ReopenSelected_Click"/>

            <Button Grid.Column="3"
                    Content="Refresh"
                    Height="30"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    Click="Refresh_Click"/>
        </Grid>

        <Grid Grid.Row="3"
              MaxWidth="960"
              HorizontalAlignment="Left">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="TasksGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="White"
                      BorderBrush="#DDDDDD"
                      BorderThickness="1">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Status"
                                        Width="100"
                                        Binding="{Binding Status}"/>

                    <DataGridTextColumn Header="Task"
                                        Width="*"
                                        Binding="{Binding Title}"/>

                    <DataGridTextColumn Header="Due"
                                        Width="130"
                                        Binding="{Binding Due}"/>

                    <DataGridTextColumn Header="Updated"
                                        Width="170"
                                        Binding="{Binding Updated}"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock x:Name="TaskErrorText"
                       Grid.Row="1"
                       Margin="0,8,0,0"
                       Foreground="#B42318"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
