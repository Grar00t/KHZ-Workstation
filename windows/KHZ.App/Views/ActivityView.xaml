<UserControl x:Class="KHZ.App.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F5F5">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Activity"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#202020"/>

                <TextBlock x:Name="ActivityCountText"
                           Text="Local execution history"
                           FontSize="11"
                           Foreground="#777777"
                           Margin="0,4,0,0"/>

                <TextBlock x:Name="ActivityErrorText"
                           Text=""
                           FontSize="10"
                           Foreground="#B42318"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Refresh"
                    Padding="18,7"
                    VerticalAlignment="Center"
                    Click="RefreshActivity_Click"/>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="6">

            <DataGrid x:Name="ActivityGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      BorderThickness="0"
                      RowHeaderWidth="0"
                      SelectionMode="Single">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time"
                                        Binding="{Binding DisplayTime}"
                                        Width="155"/>

                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Action"
                                        Binding="{Binding Action}"
                                        Width="190"/>

                    <DataGridTextColumn Header="Result"
                                        Binding="{Binding Result}"
                                        Width="110"/>

                    <DataGridTextColumn Header="Target"
                                        Binding="{Binding Target}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
