<UserControl x:Class="KHZ.App.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F7F7F8"
             Unloaded="ChatView_Unloaded">
    <UserControl.Resources>
        <Style x:Key="ChatToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="5,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#202123"
                BorderBrush="#343541"
                BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button Content="＋  New chat"
                        Height="40"
                        HorizontalContentAlignment="Left"
                        Padding="12,0"
                        Background="#202123"
                        Foreground="White"
                        BorderBrush="#565869"
                        Click="NewChat_Click"/>

                <ListBox x:Name="ConversationList"
                         Grid.Row="1"
                         Margin="0,10,0,10"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         SelectionChanged="ConversationList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"
                                       Padding="8,7"
                                       Width="195"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2">
                    <TextBlock x:Name="ContextText"
                               Foreground="#B4B4B4"
                               FontSize="10"
                               TextWrapping="Wrap"
                               Margin="6,0,6,8"/>
                    <Button Content="Delete current chat"
                            Height="32"
                            Foreground="#D9D9E3"
                            Background="#202123"
                            BorderBrush="#565869"
                            Click="DeleteChat_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="#E1E1E1"
                    BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ModelText"
                                   Text="OLMo 3"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                        <TextBlock x:Name="RuntimeStatusText"
                                   Text="Local AI disabled for this session"
                                   Foreground="#737373"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="SessionButton"
                                Style="{StaticResource ChatToolbarButton}"
                                Content="Enable local AI"
                                Click="Session_Click"/>
                        <Button x:Name="RuntimeButton"
                                Style="{StaticResource ChatToolbarButton}"
                                Content="Start model"
                                Click="Runtime_Click"/>
                        <Button Style="{StaticResource ChatToolbarButton}"
                                Content="Configure"
                                Click="Configure_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="TranscriptScroll"
                          Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="TranscriptItems"
                              Margin="0,12,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border MaxWidth="820"
                                    Margin="20,6"
                                    Padding="16,12"
                                    HorizontalAlignment="Stretch"
                                    Background="{Binding Background}"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding RoleLabel}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#737373"
                                               Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Content}"
                                               FontSize="13"
                                               Foreground="#202020"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Background="#F7F7F8"
                    Padding="22,12,22,18">
                <StackPanel MaxWidth="900"
                            HorizontalAlignment="Center">
                    <Border Background="White"
                            BorderBrush="#CFCFCF"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="90"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ComposerText"
                                     MinHeight="54"
                                     MaxHeight="180"
                                     BorderThickness="0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     KeyDown="ComposerText_KeyDown"/>
                            <StackPanel Grid.Column="1"
                                        Margin="8,0,0,0">
                                <Button x:Name="SendButton"
                                        Height="32"
                                        Content="Send"
                                        IsDefault="True"
                                        Click="Send_Click"/>
                                <Button x:Name="CancelButton"
                                        Height="28"
                                        Margin="0,6,0,0"
                                        Content="Cancel"
                                        IsEnabled="False"
                                        Click="Cancel_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="FeedbackText"
                               Margin="4,7,4,0"
                               FontSize="10"
                               Foreground="#666666"
                               TextWrapping="Wrap"
                               Text="Local model · workspace tools are bounded · PowerShell requires confirmation"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
