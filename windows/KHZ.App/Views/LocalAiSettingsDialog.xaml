<Window x:Class="KHZ.App.Views.LocalAiSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Local AI configuration"
        Width="780"
        Height="650"
        MinWidth="680"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F5F5">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Local AI"
                       FontSize="26"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Point KHZ at a local llama-server.exe and a GGUF model. KHZ does not download or replace your model."
                       Margin="0,5,0,0"
                       Foreground="#666666"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,20"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Display label"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="ModelLabelText"
                         Height="34"
                         Margin="0,6,0,16"
                         Padding="8,5"/>

                <TextBlock Text="llama-server.exe"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RuntimePathText"
                             Height="34"
                             Padding="8,5"/>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="Browse..."
                            Click="BrowseRuntime_Click"/>
                </Grid>

                <TextBlock Text="GGUF model"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ModelPathText"
                             Height="34"
                             Padding="8,5"/>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="Browse..."
                            Click="BrowseModel_Click"/>
                </Grid>

                <TextBlock Text="LoRA adapter · optional"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AdapterPathText"
                             Height="34"
                             Padding="8,5"/>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="Browse..."
                            Click="BrowseAdapter_Click"/>
                </Grid>

                <TextBlock Text="Chat template · optional"
                           FontWeight="SemiBold"/>
                <Grid Margin="0,6,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TemplatePathText"
                             Height="34"
                             Padding="8,5"/>
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Content="Browse..."
                            Click="BrowseTemplate_Click"/>
                </Grid>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Context tokens"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="ContextSizeText"
                                 Margin="0,6,0,0"
                                 Height="34"
                                 Padding="8,5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="GPU layers"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="GpuLayersText"
                                 Margin="0,6,0,0"
                                 Height="34"
                                 Padding="8,5"
                                 ToolTip="auto, all, or an integer"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="ToolsEnabledCheck"
                          Content="Allow bounded workspace tools"
                          Margin="0,0,0,10"/>
                <CheckBox x:Name="HideReasoningCheck"
                          Content="Hide model reasoning / thinking from the transcript"
                          Margin="0,0,0,10"/>

                <Border Padding="12"
                        Margin="0,6,0,0"
                        Background="#EEEEEE"
                        CornerRadius="5">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#555555"
                               Text="Read/list/search/repository tools stay inside the active workspace or folder. PowerShell execution always displays the exact proposed command and requires Yes/No confirmation."/>
                </Border>

                <TextBlock x:Name="ErrorText"
                           Margin="0,12,0,0"
                           Foreground="#B00020"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Content="Clear saved configuration"
                    Padding="12,7"
                    HorizontalAlignment="Left"
                    Click="Clear_Click"/>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">
                <Button Content="Cancel"
                        Width="90"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="Save"
                        Width="90"
                        Height="34"
                        IsDefault="True"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
