<Window x:Class="KHZ.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:KHZ.App.Views"
        Title="KHZ Workstation"
        Icon="Assets/KHZ.ico"
        Width="1440"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SHELL -->
        <Border Grid.Column="0"
                Background="#181818"
                BorderBrush="#303030"
                BorderThickness="0,0,1,0">

            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="#242424"
                            VerticalAlignment="Top">
                        <Image Source="Assets/KHZ.ico"
                               Width="32"
                               Height="32"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="10,1,0,0">
                        <TextBlock Text="KHZ"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="WORKSTATION"
                                   Foreground="#909090"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   />
                    </StackPanel>
                </Grid>

                <!-- Only implemented surfaces -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">

                    <TextBlock Text="WORKSPACE"
                               Foreground="#686868"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="10,0,0,8"/>

                    <Button x:Name="HomeButton"
                            Style="{StaticResource NavButton}"
                            Background="#303030"
                            Click="Home_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Home"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="FilesButton"
                            Style="{StaticResource NavButton}"
                            Background="#303030"
                            Click="Files_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▰"
                                       FontSize="16"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Files"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DocumentsButton"
                            Style="{StaticResource NavButton}"
                            Background="#185ABD"
                            Click="Documents_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Documents"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SheetsButton"
                            Style="{StaticResource NavButton}"
                            Background="#107C41"
                            Click="Sheets_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Sheets"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SlidesButton"
                            Style="{StaticResource NavButton}"
                            Background="#C43E1C"
                            Click="Slides_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Slides"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PdfButton"
                            Style="{StaticResource NavButton}"
                            Background="#D13438"
                            Click="Pdf_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▧"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="PDF"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ActivityButton"
                            Style="{StaticResource NavButton}"
                            Click="Activity_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◷"
                                       FontSize="16"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Activity"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SecurityButton"
                            Style="{StaticResource NavButton}"
                            Click="Security_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="◆"
                                       FontSize="13"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Security"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Truthful runtime status -->
                <StackPanel Grid.Row="2"
                            Margin="4,8,4,2">

                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RuntimeDot"
                                 Width="7"
                                 Height="7"
                                 Fill="#808080"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="RuntimeStatus"
                                   Text="Checking local runtime..."
                                   Foreground="#B0B0B0"
                                   FontSize="11"/>
                    </StackPanel>

                    <TextBlock Text="STANDARD · LOCAL"
                               Foreground="#666666"
                               FontSize="9"
                               Margin="14,5,0,0"/>

                    <Border Height="1"
                            Background="#2D2D2D"
                            Margin="0,12,0,10"/>

                    <Border Background="#232323"
                            BorderBrush="#343434"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="11,9"
                            Margin="8,2,8,10">
                        <StackPanel>
                            <TextBlock Text="LOCAL TIME"
                                       Foreground="#737373"
                                       FontSize="8"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ClockTimeText"
                                       Text="--:--:--"
                                       Foreground="#F0F0F0"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"/>

                            <TextBlock x:Name="GregorianDateText"
                                       Text="--"
                                       Foreground="#A5A5A5"
                                       FontSize="10"
                                       Margin="0,3,0,0"/>

                            <Border Height="1"
                                    Background="#353535"
                                    Margin="0,7,0,6"/>

                            <TextBlock x:Name="HijriDateText"
                                       Text="--"
                                       Foreground="#C7C7C7"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       FlowDirection="RightToLeft"
                                       HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Made by Sulaiman Alshammari"
                               Foreground="#777777"
                               FontSize="9"
                               Margin="14,0,0,0"/>

                    <TextBlock Text="KHZ Workstation"
                               Foreground="#505050"
                               FontSize="8"
                               Margin="14,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="White"
                    BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Workspace"
                                   Foreground="#8A8A8A"
                                   FontSize="10"/>

                        <TextBlock x:Name="SectionTitle"
                                   Text="Sheets"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Style="{StaticResource StatusPill}"
                                Background="#F2F2F2">
                            <TextBlock Text="LOCAL"
                                       Foreground="#505050"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border x:Name="OfficeStatusPill"
                                Style="{StaticResource StatusPill}"
                                Background="#F2F2F2">
                            <TextBlock x:Name="OfficeStatusText"
                                       Text="OFFICE CHECK"
                                       Foreground="#606060"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Button Content="↻"
                                Width="34"
                                Height="30"
                                Margin="6,0,0,0"
                                FontSize="17"
                                ToolTip="Refresh local runtime status"
                                Click="RefreshStatus_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">

                <wv2:WebView2 x:Name="OfficeWeb"/>

                <ScrollViewer x:Name="HomeSurface"
                              VerticalScrollBarVisibility="Auto"
                              Background="#F5F5F5">

                    <StackPanel MaxWidth="1080"
                                Margin="34"
                                HorizontalAlignment="Left">

                        <TextBlock Text="KHZ Workstation"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   Foreground="#202020"/>

                        <TextBlock Text="Local-first institutional workspace"
                                   Margin="0,4,0,26"
                                   FontSize="14"
                                   Foreground="#707070"/>

                        <TextBlock Text="OPEN"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#777777"
                                   Margin="0,0,0,10"/>

                        <WrapPanel>

                            <Button Width="168"
                                    Height="78"
                                    Margin="0,0,10,10"
                                    Background="#185ABD"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="Documents_Click">
                                <StackPanel>
                                    <TextBlock Text="Documents"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="DOCX workspace"
                                               FontSize="10"
                                               Margin="0,5,0,0"
                                               Opacity=".8"/>
                                </StackPanel>
                            </Button>

                            <Button Width="168"
                                    Height="78"
                                    Margin="0,0,10,10"
                                    Background="#107C41"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="Sheets_Click">
                                <StackPanel>
                                    <TextBlock Text="Sheets"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="XLSX workspace"
                                               FontSize="10"
                                               Margin="0,5,0,0"
                                               Opacity=".8"/>
                                </StackPanel>
                            </Button>

                            <Button Width="168"
                                    Height="78"
                                    Margin="0,0,10,10"
                                    Background="#C43E1C"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="Slides_Click">
                                <StackPanel>
                                    <TextBlock Text="Slides"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="PPTX workspace"
                                               FontSize="10"
                                               Margin="0,5,0,0"
                                               Opacity=".8"/>
                                </StackPanel>
                            </Button>

                            <Button Width="168"
                                    Height="78"
                                    Margin="0,0,10,10"
                                    Background="#D13438"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="Pdf_Click">
                                <StackPanel>
                                    <TextBlock Text="PDF"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="PDF workspace"
                                               FontSize="10"
                                               Margin="0,5,0,0"
                                               Opacity=".8"/>
                                </StackPanel>
                            </Button>

                            <Button Width="168"
                                    Height="78"
                                    Margin="0,0,10,10"
                                    Background="#303030"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="Files_Click">
                                <StackPanel>
                                    <TextBlock Text="Files"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Browse local files"
                                               FontSize="10"
                                               Margin="0,5,0,0"
                                               Opacity=".8"/>
                                </StackPanel>
                            </Button>

                        </WrapPanel>

                        <TextBlock Text="SYSTEM"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#777777"
                                   Margin="0,24,0,10"/>

                        <Border Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="20"
                                Width="700"
                                HorizontalAlignment="Left">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Build"
                                           Foreground="#777777"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="Standard · Local"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="1"
                                           Text="Office runtime"
                                           Foreground="#777777"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="HomeRuntimeStatus"
                                           Grid.Row="1"
                                           Grid.Column="1"
                                           Text="Checking..."
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="2"
                                           Text="Office boundary"
                                           Foreground="#777777"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Text="localhost:8090 only"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Row="3"
                                           Text="External navigation"
                                           Foreground="#777777"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           Text="Blocked"
                                           FontWeight="SemiBold"
                                           Foreground="#287A38"
                                           VerticalAlignment="Center"/>

                            </Grid>
                        </Border>

                        <Border Background="#EEEEEE"
                                CornerRadius="5"
                                Padding="14"
                                Margin="0,22,0,0"
                                Width="700"
                                HorizontalAlignment="Left">

                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#666666"
                                       FontSize="11">
                                <Run Text="Developer Preview · "/>
                                <Run Text="KHZ Workstation is designed as a general workspace. "/>
                                <Run Text="Business systems and institutional modules are added through replaceable integrations."/>
                            </TextBlock>
                        </Border>

                    </StackPanel>
                </ScrollViewer>


                <!-- =========================================
                     ACTIVITY
                     ========================================= -->
                <views:ActivityView x:Name="ActivitySurface"
                                    Visibility="Collapsed"/>


                <!-- =========================================
                     SECURITY CENTER
                     ========================================= -->
                <views:SecurityView x:Name="SecuritySurface"
                                    Visibility="Collapsed"/>


                <Grid x:Name="FilesSurface"
                      Visibility="Collapsed"
                      Background="#F7F7F7">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="White"
                            BorderBrush="#DEDEDE"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="↑"
                                    Width="34"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Up"
                                    Click="Up_Click"/>

                            <Button Grid.Column="1"
                                    Content="Open folder"
                                    Height="32"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Click="ChooseFolder_Click"/>

                            <TextBlock x:Name="CurrentFolderText"
                                       Grid.Column="2"
                                       Margin="14,0"
                                       VerticalAlignment="Center"
                                       Foreground="#555555"
                                       TextTrimming="CharacterEllipsis"/>

                            <Button Grid.Column="3"
                                    Content="↻"
                                    Width="34"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    ToolTip="Refresh"
                                    Click="RefreshFiles_Click"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="FilesList"
                              Grid.Row="1"
                              Margin="14"
                              BorderThickness="0"
                              Background="White"
                              MouseDoubleClick="FilesList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name"
                                                Width="430"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type"
                                                Width="110"
                                                DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="Modified"
                                                Width="180"
                                                DisplayMemberBinding="{Binding Modified}"/>
                                <GridViewColumn Header="Size"
                                                Width="110"
                                                DisplayMemberBinding="{Binding Size}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock x:Name="FilesError"
                               Grid.Row="2"
                               Foreground="#B00020"
                               Margin="16,0,16,12"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
