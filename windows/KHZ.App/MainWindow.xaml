<Window x:Class="KHZ.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="KHZ Workstation"
        Icon="Assets/KHZ.ico"
        Width="1440"
        Height="900"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="StatusPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SHELL -->
        <Border Grid.Column="0"
                Background="#181818"
                BorderBrush="#303030"
                BorderThickness="0,0,1,0">

            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="76"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="38"
                            Height="38"
                            CornerRadius="8"
                            Background="#242424"
                            VerticalAlignment="Top">
                        <Image Source="Assets/KHZ.ico"
                               Width="32"
                               Height="32"/>
                    </Border>

                    <StackPanel Grid.Column="1"
                                Margin="10,1,0,0">
                        <TextBlock Text="KHZ"
                                   Foreground="White"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="WORKSTATION"
                                   Foreground="#909090"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   />
                    </StackPanel>
                </Grid>

                <!-- Only implemented surfaces -->
                <StackPanel Grid.Row="1" Margin="0,10,0,0">

                    <TextBlock Text="WORKSPACE"
                               Foreground="#686868"
                               FontSize="9"
                               FontWeight="SemiBold"
                               Margin="10,0,0,8"/>

                    <Button x:Name="FilesButton"
                            Style="{StaticResource NavButton}"
                            Background="#303030"
                            Click="Files_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▰"
                                       FontSize="16"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Files"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="DocumentsButton"
                            Style="{StaticResource NavButton}"
                            Background="#185ABD"
                            Click="Documents_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Documents"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SheetsButton"
                            Style="{StaticResource NavButton}"
                            Background="#107C41"
                            Click="Sheets_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Sheets"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SlidesButton"
                            Style="{StaticResource NavButton}"
                            Background="#C43E1C"
                            Click="Slides_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Slides"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PdfButton"
                            Style="{StaticResource NavButton}"
                            Background="#D13438"
                            Click="Pdf_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▧"
                                       FontSize="17"
                                       Width="28"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="PDF"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Truthful runtime status -->
                <StackPanel Grid.Row="2"
                            Margin="4,8,4,2">

                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RuntimeDot"
                                 Width="7"
                                 Height="7"
                                 Fill="#808080"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"/>

                        <TextBlock x:Name="RuntimeStatus"
                                   Text="Checking local runtime..."
                                   Foreground="#B0B0B0"
                                   FontSize="11"/>
                    </StackPanel>

                    <TextBlock Text="STANDARD · LOCAL"
                               Foreground="#666666"
                               FontSize="9"
                               Margin="14,5,0,0"/>

                    <Border Height="1"
                            Background="#2D2D2D"
                            Margin="0,12,0,10"/>

                    <TextBlock Text="Made by Sulaiman Alshammari"
                               Foreground="#777777"
                               FontSize="9"
                               Margin="14,0,0,0"/>

                    <TextBlock Text="KHZ Workstation"
                               Foreground="#505050"
                               FontSize="8"
                               Margin="14,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Background="White"
                    BorderBrush="#D8D8D8"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Workspace"
                                   Foreground="#8A8A8A"
                                   FontSize="10"/>

                        <TextBlock x:Name="SectionTitle"
                                   Text="Sheets"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Style="{StaticResource StatusPill}"
                                Background="#F2F2F2">
                            <TextBlock Text="LOCAL"
                                       Foreground="#505050"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Border x:Name="OfficeStatusPill"
                                Style="{StaticResource StatusPill}"
                                Background="#F2F2F2">
                            <TextBlock x:Name="OfficeStatusText"
                                       Text="OFFICE CHECK"
                                       Foreground="#606060"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <Button Content="↻"
                                Width="34"
                                Height="30"
                                Margin="6,0,0,0"
                                FontSize="17"
                                ToolTip="Refresh local runtime status"
                                Click="RefreshStatus_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">

                <wv2:WebView2 x:Name="OfficeWeb"/>

                <Grid x:Name="FilesSurface"
                      Visibility="Collapsed"
                      Background="#F7F7F7">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="White"
                            BorderBrush="#DEDEDE"
                            BorderThickness="0,0,0,1">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Content="↑"
                                    Width="34"
                                    Height="32"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip="Up"
                                    Click="Up_Click"/>

                            <Button Grid.Column="1"
                                    Content="Open folder"
                                    Height="32"
                                    Padding="12,0"
                                    VerticalAlignment="Center"
                                    Click="ChooseFolder_Click"/>

                            <TextBlock x:Name="CurrentFolderText"
                                       Grid.Column="2"
                                       Margin="14,0"
                                       VerticalAlignment="Center"
                                       Foreground="#555555"
                                       TextTrimming="CharacterEllipsis"/>

                            <Button Grid.Column="3"
                                    Content="↻"
                                    Width="34"
                                    Height="32"
                                    VerticalAlignment="Center"
                                    ToolTip="Refresh"
                                    Click="RefreshFiles_Click"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="FilesList"
                              Grid.Row="1"
                              Margin="14"
                              BorderThickness="0"
                              Background="White"
                              MouseDoubleClick="FilesList_MouseDoubleClick">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name"
                                                Width="430"
                                                DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Type"
                                                Width="110"
                                                DisplayMemberBinding="{Binding Type}"/>
                                <GridViewColumn Header="Modified"
                                                Width="180"
                                                DisplayMemberBinding="{Binding Modified}"/>
                                <GridViewColumn Header="Size"
                                                Width="110"
                                                DisplayMemberBinding="{Binding Size}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <TextBlock x:Name="FilesError"
                               Grid.Row="2"
                               Foreground="#B00020"
                               Margin="16,0,16,12"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
